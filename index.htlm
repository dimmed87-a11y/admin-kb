<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>База знаний администратора — ЦЛСИС</title>
<style>
:root {
  --navy: #16305c;
  --navy-2: #1f3864;
  --ink: #1c2430;
  --ink-soft: #55606e;
  --bg: #f4f6f9;
  --card: #ffffff;
  --line: #e2e6ed;
  --accent: #3563a8;
  --mark-bg: #ffe38a;
  --radius: 10px;
  font-size: 16px;
}
* { box-sizing: border-box; }
html, body { margin:0; padding:0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
svg.ic { width: 1em; height: 1em; display:inline-block; vertical-align: -0.15em; }
svg.ic, .cat-icon svg, .chev, .empty-state svg {
  fill: none; stroke: currentColor; stroke-width: 1.7;
  stroke-linecap: round; stroke-linejoin: round;
}

/* ---------- header ---------- */
header.top {
  position: sticky; top: 0; z-index: 30;
  background: linear-gradient(155deg, var(--navy) 0%, var(--navy-2) 100%);
  color: #fff;
  padding: 22px 20px 20px;
  box-shadow: 0 6px 18px rgba(15,30,60,.18);
}
.top-inner { max-width: 980px; margin: 0 auto; }
.top-title {
  font-size: 1.28rem; font-weight: 700; letter-spacing: -0.01em;
  display:flex; align-items:center; gap:10px; margin: 0 0 3px;
}
.top-sub { font-size: .86rem; color: #b9c8e6; margin: 0 0 16px; }
.search-wrap {
  position: relative;
  background: rgba(255,255,255,.98);
  border-radius: 12px;
  box-shadow: 0 2px 10px rgba(0,0,0,.15);
}
.search-wrap svg.ic {
  position:absolute; left:16px; top:50%; transform:translateY(-50%);
  width: 19px; height:19px; color:#8792a3;
}
#search {
  width:100%; border:none; outline:none; background:transparent;
  font-size: 1.02rem; padding: 14px 44px 14px 46px; color: var(--ink);
  font-family: inherit; border-radius: 12px;
}
#search::placeholder { color:#9aa5b5; }
#clear-btn {
  position:absolute; right:8px; top:50%; transform:translateY(-50%);
  width:30px; height:30px; border-radius:50%; border:none; cursor:pointer;
  background:#eef1f6; color:#5b6577; display:none; align-items:center; justify-content:center;
}
#clear-btn.show { display:flex; }
#clear-btn svg { width:14px; height:14px; }
#clear-btn:hover { background:#e2e6ee; }

.chips {
  display:flex; gap:8px; flex-wrap:wrap; margin-top: 14px;
}
.chip {
  border: 1px solid rgba(255,255,255,.28);
  background: rgba(255,255,255,.08);
  color: #dbe4f4;
  padding: 6px 13px;
  border-radius: 999px;
  font-size: .82rem;
  cursor: pointer;
  user-select: none;
  display:flex; align-items:center; gap:6px;
  transition: background .15s, color .15s, border-color .15s;
  white-space: nowrap;
}
.chip svg { width: 13px; height:13px; }
.chip:hover { background: rgba(255,255,255,.16); }
.chip.active { background:#fff; color: var(--navy); border-color:#fff; font-weight:600; }

/* ---------- main ---------- */
main { max-width: 980px; margin: 0 auto; padding: 22px 20px 60px; }
.status-line {
  font-size: .86rem; color: var(--ink-soft); margin: 2px 4px 16px;
  min-height: 1.2em;
}
.status-line b { color: var(--ink); }

.category { margin-bottom: 22px; }
.category-head {
  display:flex; align-items:center; gap:10px;
  padding: 4px 2px 10px;
}
.cat-icon {
  width: 30px; height:30px; border-radius: 8px;
  display:flex; align-items:center; justify-content:center;
  color:#fff; flex-shrink:0;
}
.cat-icon svg { width:16px; height:16px; }
.category-head h2 {
  font-size: 1.04rem; margin:0; font-weight:700; color: var(--ink);
}
.category-head .count {
  font-size: .78rem; color: var(--ink-soft); font-weight:500;
  background:#e9edf3; padding:2px 9px; border-radius:999px; margin-left:2px;
}

.card-list {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}
.entry { border-bottom: 1px solid var(--line); }
.entry:last-child { border-bottom: none; }
.entry-btn {
  width:100%; text-align:left; background:none; border:none; cursor:pointer;
  padding: 13px 16px; display:flex; align-items:center; gap:10px;
  font-family: inherit; font-size: .95rem; color: var(--ink); font-weight:600;
}
.entry-btn:hover { background:#f8f9fc; }
.entry-btn .chev {
  margin-left:auto; width:15px; height:15px; color:#9aa5b5; flex-shrink:0;
  transition: transform .18s ease;
}
.entry.open .entry-btn .chev { transform: rotate(90deg); }
.entry-body {
  max-height: 0; overflow: hidden; transition: max-height .22s ease;
}
.entry.open .entry-body { max-height: 900px; }
.entry-body-inner {
  padding: 0 16px 16px 42px;
  font-size: .91rem; color: var(--ink-soft);
}
.entry-body-inner .line { margin: 0 0 4px; }
.entry-body-inner .line:last-child { margin-bottom:0; }
.note {
  margin-top: 10px; padding: 9px 12px;
  background: #eef3fb; border-left: 3px solid var(--accent);
  border-radius: 0 6px 6px 0; font-size: .85rem; color:#33507a;
}
.note.sensitive { background:#fff5e8; border-left-color:#c07f16; color:#7a5411; }

.attachments { margin-top: 10px; display:flex; flex-direction:column; gap:6px; }
.attachment-link {
  display:inline-flex; align-items:center; gap:7px;
  padding: 7px 11px; background:#fff; border:1px solid var(--line);
  border-radius: 7px; font-size:.85rem; color: var(--accent); text-decoration:none;
  width: fit-content; max-width:100%;
}
.attachment-link:hover { background:#f4f7fb; border-color: var(--accent); }
.attachment-link svg { width:14px; height:14px; flex-shrink:0; }

mark { background: var(--mark-bg); color: inherit; border-radius: 3px; padding: 0 1px; }

.empty-state {
  text-align:center; padding: 60px 20px; color: var(--ink-soft);
}
.empty-state svg { width:38px; height:38px; color:#c3cbd8; margin-bottom:10px; }

footer {
  text-align:center; font-size:.78rem; color:#9aa5b5; padding: 10px 20px 40px;
}

@media (max-width: 600px) {
  :root { font-size: 15px; }
  header.top { padding: 14px 14px 12px; }
  .top-sub {
    margin-bottom: 12px; overflow:hidden; text-overflow:ellipsis;
    white-space:nowrap;
  }
  .chips {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 12px -14px 0;
    padding: 0 14px 4px;
  }
  .chips::-webkit-scrollbar { display:none; }
  .chip { flex-shrink: 0; white-space: nowrap; }
  main { padding: 16px 12px 50px; }
  .entry-body-inner { padding-left: 16px; }
}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute"><symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.8-4 5-6 8-6s6.2 2 8 6"></path></symbol><symbol id="i-gift" viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="12" rx="1"></rect><path d="M4 9h16v4H4z"></path><path d="M12 9v12"></path><path d="M12 9C9.5 9 8 7.5 8 5.8 8 4.3 9 3 10.3 3 12 3 12 6 12 9Z"></path><path d="M12 9c2.5 0 4-1.5 4-3.2C16 4.3 15 3 13.7 3 12 3 12 6 12 9Z"></path></symbol><symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4V5Z"></path><path d="M8 9h8"></path><path d="M8 12h5"></path></symbol><symbol id="i-receipt" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"></path><path d="M9 8h6"></path><path d="M9 12h6"></path></symbol><symbol id="i-pulse" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M7 12h2l1.5-4 3 8L15 12h2"></path></symbol><symbol id="i-drop" viewBox="0 0 24 24"><path d="M12 3c3.5 4.2 6 7.6 6 10.7A6 6 0 0 1 6 13.7C6 10.6 8.5 7.2 12 3Z"></path></symbol><symbol id="i-clipboard" viewBox="0 0 24 24"><rect x="6" y="4" width="12" height="17" rx="1.5"></rect><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"></path><path d="M9 11h6"></path><path d="M9 15h6"></path><path d="M9 19h4"></path></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6l7-3Z"></path><path d="M9.5 12l1.8 1.8L14.5 10"></path></symbol><symbol id="i-stetho" viewBox="0 0 24 24"><path d="M6 4v6a4 4 0 0 0 8 0V4"></path><path d="M10 14v2a5 5 0 0 0 10 0v-1.5"></path><circle cx="20" cy="12.5" r="1.6"></circle><circle cx="6" cy="4" r="1.4"></circle><circle cx="10" cy="4" r="1.4"></circle></symbol><symbol id="i-flask" viewBox="0 0 24 24"><path d="M10 3h4"></path><path d="M11 3v6.2L5.5 18a2 2 0 0 0 1.7 3h9.6a2 2 0 0 0 1.7-3L13 9.2V3"></path><path d="M8 15h8"></path></symbol><symbol id="i-wrench" viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-.6-.6-2 2.6-2.6Z"></path></symbol><symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></symbol><symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></symbol><symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"></path></symbol><symbol id="i-paperclip" viewBox="0 0 24 24"><path d="M8 10.5V16a4 4 0 0 0 8 0V7a2.5 2.5 0 0 0-5 0v8a1 1 0 0 0 2 0V9"></path></symbol></svg>

<header class="top">
  <div class="top-inner">
    <p class="top-title"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M7 12h2l1.5-4 3 8L15 12h2"></path></svg> База знаний администратора</p>
    <p class="top-sub">Центр Лечения Суставов и Сердца — поиск по всем инструкциям, шаблонам и контактам</p>
    <div class="search-wrap">
      <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
      <input id="search" type="text" placeholder="Например: тревожная кнопка, Loyalmed, справка, монитор…" autocomplete="off">
      <button id="clear-btn" aria-label="Очистить"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg></button>
    </div>
    <div class="chips" id="chips"></div>
  </div>
</header>

<main>
  <p class="status-line" id="status"></p>
  <div id="results"></div>
  <div class="empty-state" id="empty" style="display:none">
    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <p>Ничего не найдено. Попробуйте другой запрос или общее слово.</p>
  </div>
</main>

<footer>База знаний хранится в этом файле — открывайте и делитесь им как обычным HTML-файлом.</footer>

<script>
const DATA = [{"id": "lk", "title": "Личный кабинет и сайт", "icon": "user", "color": "#2E5395", "entries": [{"title": "Что такое личный кабинет (ЛК)", "body": ["В ЛК пациенту доступны все заключения врачей, пройденные исследования и результаты анализов в PDF. Администратор должен пошагово объяснить пациенту, как зарегистрироваться и получить нужные документы."], "note": "Ссылка на вход: online-rheumacardiolog.medods.ru", "id": "e1"}, {"title": "Пациент в клинике — как направить в ЛК", "body": ["Зайти через любой браузер на сайт «Центр Лечения Суставов и Сердца». На главном экране нажать синий кружок «Личный кабинет пациента» и перейти на страницу регистрации."], "note": "", "id": "e2"}, {"title": "Пациент пишет в мессенджере", "body": ["Отправить ссылку online-rheumacardiolog.medods.ru и инструкцию по входу/регистрации."], "note": "", "id": "e3"}, {"title": "Порядок регистрации в ЛК", "body": ["1. В меню наверху справа нажать стрелочку «вход», затем «регистрация».", "2. Заполнить имя, фамилию пациента и контактный телефон (с +7), указанный при оформлении в клинике.", "3. Выбрать способ подтверждения — входящий звонок; ввести последние 4 цифры номера входящего звонка в поле «код», нажать «регистрация».", "4. Подтвердить автоматически сформированный пароль или задать свой."], "note": "", "id": "e4"}, {"title": "Заключение не видно пациенту", "body": ["Проверить в карте пациента, поставил ли доктор галочку на исследовании/заключении.", "• Если галочка стоит — попросить доктора проверить внутреннюю галочку (если доктор в отпуске/уже не работает — уточнить у руководителя Анжелики).", "• Если галочки нет — попросить доктора поставить."], "note": "", "id": "e5"}, {"title": "Анализы не видны, срок готовности прошёл", "body": ["Зайти в карту пациента и проверить, подкреплены ли результаты.", "Если результаты есть, но галочки нет — попросить лабораторию поставить галочку."], "note": "", "id": "e6"}, {"title": "Чат-бот на сайте", "body": ["Чат быстрой коммуникации с пациентами на сайте https://rheumacardiolog.ru/. На сообщения отвечает второй администратор (тот, чья смена не за кассой)."], "note": "", "id": "e7"}]}, {"id": "loyalmed", "title": "Программа лояльности Loyalmed", "icon": "gift", "color": "#2E5395", "entries": [{"title": "Что это", "body": ["Бонусная система для пациентов в формате чат-бота в Telegram и MAX. Пациент может смотреть свои записи на приём, записываться через администраторов, подтверждать/переносить запись, копить и списывать бонусы."], "note": "", "id": "e8"}, {"title": "Начисление бонусов", "body": ["Приветственное начисление — 500 бонусов.", "Начисление при оплате: сначала 3%, затем 5%, затем 10% — процент растёт автоматически в зависимости от общей суммы, уплаченной пациентом за все услуги."], "note": "", "id": "e9"}, {"title": "Списание бонусов", "body": ["Можно списать до 10% от суммы услуги при последующей оплате."], "note": "", "id": "e10"}, {"title": "Подключение пациента к программе", "body": ["1. Пациент сканирует QR-код Telegram или MAX и переходит в чат-бот.", "2. Нажимает кнопку «начать» и делится контактом — чтобы чат-бот идентифицировал пациента в нашей программе.", "3. Администратор, увидев подключение, ставит пациенту в карте (Медодс) группу «Loyalmed»."], "note": "", "id": "e11"}, {"title": "Выставление счёта пациенту с чат-ботом", "body": ["При выставлении счёта в системе Loyalmed администратору придёт сообщение, сколько бонусов доступно у пациента для списания."], "note": "", "id": "e12"}, {"title": "Списание при оплате", "body": ["Предложить пациенту списать бонусы или продолжить копить.", "Если пациент хочет списать — переоформить АКТ с указанием скидки «количество бонусов» в рублях, напечатать новые АКТы, озвучить пациенту итоговую сумму с учётом списания и оплатить услугу."], "note": "", "id": "e13"}]}, {"id": "consult", "title": "Консультации по документам и онлайн", "icon": "chat", "color": "#2E5395", "entries": [{"title": "Консультация по документам — что это", "body": ["Письменное заключение лечащего доктора по результатам всех назначенных исследований. Доступна пациенту, если доктор прописал это в заключении либо сказал администратору лично."], "note": "", "id": "e14"}, {"title": "Консультация по документам — порядок оформления", "body": ["1. Пациент звонит/пишет администратору и сообщает, что прошёл все обследования.", "2. Администратор уточняет у доктора, возможна ли консультация для этого пациента.", "3. Если доктор разрешает — просим руководителя Анжелику выставить счёт.", "4. Отправляем пациенту счёт в мессенджере с текстом-шаблоном.", "5. Просим пациента прислать исследования/анализы/заключения по назначению доктора; подкрепляем в электронную карту в раздел «Файлы».", "6. Когда оплата поступила и все документы получены — сообщаем доктору; заключение готово за 1–2 дня и появляется в ЛК пациента."], "note": "Шаблон сообщения со счётом: «Отправляем Вам счёт на оплату онлайн-консультации с доктором. Счет можно оплатить через: мобильное приложение Сбербанка; личный кабинет Сбербанка онлайн; обращение в отделение Сбербанка. Оплата производится на расчетный счет ООО «Ревмоцентр», номер счета начинается на 4070. После оплаты отправьте нам пожалуйста, подтверждение платежа»", "id": "e15"}, {"title": "Онлайн-консультация — когда возможна", "body": ["Только повторная консультация — если пациент уже был очно на приёме у ЭТОГО специалиста.", "Если пациент был очно у другого доктора и хочет попасть онлайн к новому специалисту — недоступно, первичный приём у нового доктора только очно."], "note": "", "id": "e16"}, {"title": "Онлайн-консультация — запись", "body": ["Через сайт центра — пациент оставляет заявку. После обработки заявки администратору приходит счёт, который нужно отправить пациенту."], "note": "СМС-инструкция пациенту: «Заявку на онлайн-консультацию необходимо оставить на нашем сайте https://rheumacardiolog.ru/dist-sec-cons/ После обработки заявки, когда счёт будет готов, отправим его Вам для оплаты, после чего согласовывается дата и время приёма с доктором.»", "id": "e17"}, {"title": "Онлайн-консультация — шаблон счёта", "body": ["«Отправляем Вам счёт на оплату онлайн-консультации с доктором [ФИО доктора]. Счет можно оплатить через: мобильное приложение Сбербанка; личный кабинет Сбербанка онлайн; обращение в отделение Сбербанка. Оплата производится на расчетный счет ООО «Ревмоцентр», номер счета начинается на 4070. После оплаты отправьте нам пожалуйста, подтверждение платежа.»"], "note": "Подставлять ФИО нужного доктора", "id": "e18"}, {"title": "Онлайн-консультация — после оплаты", "body": ["1. Уточняем поступление средств на счёт клиники.", "2. Проводим оплату через систему, отправляем пациенту акт и чек (скан/фото).", "3. Согласовываем с доктором дату и время, предлагаем пациенту.", "4. Записываем пациента с пометкой «Онлайн оплачено».", "5. Отправляем инструкцию по подключению, предупреждаем, что ссылка придёт в день приёма за несколько минут до начала.", "6. Просим прислать нужные для доктора исследования и подкрепляем их в карту."], "note": "", "id": "e19"}, {"title": "Онлайн-консультация — подключение в день приёма", "body": ["Отправляем ссылку https://rheumacardiolog.ktalk.ru/u8nvhai2mhj0 доктору и пациенту, подключаем обоих через красный телефон в программе TOLK к конференции, убеждаемся в стабильном соединении и видимости/слышимости, затем выходим."], "note": "", "id": "e20"}, {"title": "Онлайн-консультация — после приёма", "body": ["Врач пишет заключение для пациента и подкрепляет его в личный кабинет — пациент увидит его там."], "note": "", "id": "e21"}]}, {"id": "tax", "title": "Налоговый вычет (справки)", "icon": "receipt", "color": "#2E5395", "entries": [{"title": "Общая информация", "body": ["Справка для налоговой (денежный вычет) выдаётся на электронную почту, указанную в договоре при оформлении, либо лично по оригиналу паспорта (пациент заполняет квиток: № справки, дата, подпись).", "Если почта не указана, но пациент хочет получить справку на неё — нужно заявление о внесении эл. почты в карту."], "note": "", "id": "e22"}, {"title": "За какой период выдаётся справка", "body": ["Только за три предыдущих года. За текущий год справка оформляется в следующем году."], "note": "Пример: в 2026 году доступны справки за 2023, 2024 и 2025 год", "id": "e23"}, {"title": "Порядок действий при запросе справки", "body": ["1. Уточнить, за какой год нужна справка.", "2. Отправить пациенту соответствующий шаблон заявления о вычете.", "3. Когда пациент прислал заполненное заявление — распечатать, проверить полноту и правильность заполнения, зафиксировать кто из администраторов принял и когда; записать ФИО пациента, год и дату подачи в папку на ресепшене; отложить заявление в общую стопку.", "4. Заявления передаются на 3-й этаж каждую пятницу. По готовности справки отправляются пациентам на почту (либо выдаются лично строго по оригиналу паспорта в рабочие часы клиники)."], "note": "", "id": "e24"}, {"title": "Шаблон заявления — 2024/2025 год", "body": ["«В связи с приказом ФНС России от 08.11.2023 № ЕА-7-11/824@ об утверждении новой формы справки об оплате медицинских услуг за 2024-2025 год, Вам необходимо заполнить заявление (во вложении). Обращаем Ваше внимание, что новая форма справки об оплате медицинских услуг за 2024-2025 г. оформляется в течение 30 дней.»"], "note": "", "id": "e25"}, {"title": "Шаблон заявления — 2023 год", "body": ["«Для оформления справки для налоговой за 2023 год заполните пожалуйста собственноручно все строки заявления и пришлите нам заполненный экземпляр (скан/фото). Так же понадобится копия ИНН (скан/фото).»"], "note": "", "id": "e26"}]}, {"id": "monitors", "title": "Мониторы, ЭКГ, рецепты", "icon": "pulse", "color": "#2E5395", "entries": [{"title": "Виды мониторов", "body": ["• ХОЛТЕР — монитор сердечного ритма / суточное ЭКГ-мониторирование (ХМ-ЭКГ)", "• СМАД — суточное мониторирование артериального давления", "• Респираторный скрининг — пациент устанавливает сам перед сном; выявляет проблемы с дыханием во сне (апноэ, гипноэ)"], "note": "", "id": "e27"}, {"title": "Совместимость установки в один день", "body": ["Можно: Холтер + СМАД, Холтер + Респираторный скрининг.", "НЕЛЬЗЯ: СМАД + Респираторный скрининг вместе."], "note": "", "id": "e28"}, {"title": "Кто устанавливает и расшифровывает", "body": ["Холтер и СМАД — может установить любой кардиолог, расшифровывает лечащий врач.", "Респираторный скрининг устанавливают: Таджиева Н.И., Удачкина Е.В., Новикова Д.С. Расшифровывает ТОЛЬКО Таджиева Н.И."], "note": "", "id": "e29"}, {"title": "Порядок записи на монитор", "body": ["Сначала уточнить, какой монитор нужен пациенту. Запись к кардиологу — интервал 30 минут.", "Респираторный скрининг — запись только к Таджиевой Н.И. (у неё открыта запись каждый день, в нерабочие дни с пометкой «День мониторов»), плюс запись к доктору, который будет устанавливать монитор (с пометкой ФИО пациента)."], "note": "", "id": "e30"}, {"title": "Расшифровка монитора", "body": ["Занимает 2–3 рабочих дня, заключение появляется в ЛК пациента. Когда доктор выносит заключение вместе с дневником пациента (действия/активность/приём препаратов за день) — дневник сканируем и подкрепляем в карту пациента."], "note": "", "id": "e31"}, {"title": "ЭКГ — кто может записаться", "body": ["В рамках приёма доктора-кардиолога, либо если пациент уже наблюдается у кардиолога центра (при наблюдении у другого специалиста — по согласованию с кардиологом, который будет расшифровывать плёнку)."], "note": "", "id": "e32"}, {"title": "ЭКГ — порядок проведения", "body": ["Плёнку снимает медсестра смены (каб. 11). Расшифровывает кардиолог, к которому в этот день записан пациент, либо (при непредвиденных обстоятельствах, например задержке приёма) любой свободный кардиолог."], "note": "", "id": "e33"}, {"title": "ЭКГ — оформление", "body": ["Администратор делает скан и копию плёнки ЭКГ. Скан подкрепляется в электронную карту в раздел «Файлы», копия вклеивается в бумажную карту. Расшифровка доступна пациенту в ЛК."], "note": "", "id": "e34"}, {"title": "Рецепты — обычные бланки", "body": ["Выдаёт старшая медсестра, она же ведёт журналы выдачи бланков рецептов."], "note": "", "id": "e35"}, {"title": "Рецепты — номерные (психиатр)", "body": ["Врач-психиатр может запросить номерной рецепт на сильнодействующие препараты — выдаёт также ст. медсестра.", "Администратор ОБЯЗАТЕЛЬНО делает копию номерного рецепта, вклеивает в бумажную карту, скан подкрепляет в электронную карту в раздел «Файлы»."], "note": "", "id": "e36"}]}, {"id": "drips", "title": "Капельницы", "icon": "drop", "color": "#2E5395", "entries": [{"title": "Общее правило", "body": ["В клинике капают ТОЛЬКО препаратом клиники. Препарат, принесённый пациентом, — не капаем.", "Процедура проводится только по назначению доктора нашей клиники и только после Врачебной комиссии (ВК)."], "note": "", "id": "e37"}, {"title": "Врачебная комиссия (ВК)", "body": ["Проводится специалистами клиники во главе с доктором Клюквиной Н.Г. Для ВК пациент должен предоставить полный перечень анализов и исследований согласно памятке на введение препарата."], "note": "", "id": "e38"}, {"title": "Необходимые анализы для ВК", "body": ["• Клинический анализ крови (давностью до месяца)", "• Общий анализ мочи (давностью до месяца)", "• Биохимический анализ крови: глюкоза, АСТ, АЛТ, креатинин, общий белок (давностью до месяца — врач может скорректировать перечень)", "• Иммуноглобулины IgG, IgM, IgA, CD19+ клетки (давностью до 3 месяцев)", "• ЭКГ (при показаниях, давностью до месяца)", "• Флюорография / рентгенограмма / МСКТ органов грудной клетки (давностью до 1 года, врач может скорректировать интервал)", "• HBs-антиген, анти-HCV, RW, анти-ВИЧ (давностью до 1 года)", "• Выписки (копии) из стационара за последние 1–2 года при наличии"], "note": "", "id": "e39"}, {"title": "Когда можно записать пациента на капельницу", "body": ["Только когда в карте подкреплён протокол проведённой ВК давностью не более 3 месяцев и после согласования с Клюквиной Н.Г.", "ВАЖНО: убедиться в наличии нужного препарата (вопросы — старшей медсестре Ирине). Если препарата не хватает — сообщить Анжелике и записывать пациента только после согласования даты закупки."], "note": "", "id": "e40"}, {"title": "Длительность капельницы: Ацеллбия 500 мг", "body": ["Инициация (первое введение) — от 4 часов. Повторное введение — от 3 часов."], "note": "", "id": "e41"}, {"title": "Длительность капельницы: Ацеллбия 1000 мг", "body": ["Инициация (первое введение) — от 5,5 часов. Повторное введение — от 4,5 часов."], "note": "Длительность может увеличиваться в зависимости от переносимости препарата", "id": "e42"}]}, {"id": "shifts", "title": "Смены и отчёты", "icon": "clipboard", "color": "#2E5395", "entries": [{"title": "Открытие смены — кассир", "body": ["• Подсчёт наличных, подготовить размен в кассе", "• Проверка кассовой ленты за кассой и в терминале (заменить при необходимости)", "• Проверка зарядки на часах, передающих сигнал для помощи пациенту, и на терминале", "• Открытие смены в программе Medods, напечатанный чек сохранить для отчётности"], "note": "", "id": "e43"}, {"title": "Открытие смены — второй администратор", "body": ["• Включить компьютеры и технику в рабочих кабинетах, проверить наличие бумаги в принтере", "• Включить вывеску ЦЛСИС", "• Поставить батарейки для мониторов на зарядку", "• Включить музыку в клинике и в туалете", "• Включить видео «врачи» на телевизоре и слайды с акциями клиники на табло", "• Включить устройство для дезинфекции (дезар)"], "note": "", "id": "e44"}, {"title": "Закрытие смены — кассир", "body": ["• Сверка итогов по кассе: снятие промежуточных чеков с кассы и терминала, подсчёт наличных, заметка об онлайн-оплатах, подсчёт кассовых чеков", "• Заполнение отчётов (красная и белая папка)", "• Закрытие смены в программе — снять 2 итоговых чека: отчёт с гашением (касса) и чек сверки итогов (терминал)"], "note": "", "id": "e45"}, {"title": "Закрытие смены — второй администратор", "body": ["• Проверка кабинетов: выключить компьютеры, принтеры, кондиционеры/печки, вынуть всё из розеток", "• Проверка окон — всё ли закрыто", "• Выключить вывеску ЦЛСИС", "• Выключить музыку в клинике и в туалете", "• Выключить видео «врачи» на телевизоре и слайды с акциями на табло", "• Выключить устройство для дезинфекции (дезар)", "• Проверить 11-й кабинет — верхний (потолочный) обогреватель"], "note": "", "id": "e46"}, {"title": "Отчёт: Кассовый отчёт", "body": ["Заполняет администратор за кассой каждый день в конце смены, по чеку закрытия смены (чек с гашением).", "Указываем: дату; номер кассового отчёта; приход по терминалу (безнал); приход наличных; возврат (если был); общую сумму прихода."], "note": "", "id": "e47"}, {"title": "Отчёт: по наличным средствам", "body": ["Красная папка, тумбочка, второй выдвижной ящик (вместе с кассовым отчётом).", "Указываем: дату; остаток наличных на начало смены; инкассацию (если была); приход наличных за смену; остаток на конец дня; подпись администратора-кассира."], "note": "", "id": "e48"}, {"title": "Отчёт: таблица установки мониторов", "body": ["Висит справа у принтера второго администратора.", "Указываем: № по порядку; ФИО пациента; какой монитор установлен; ФИО доктора, установившего монитор; дату и время установки; ФИО доктора, расшифровавшего монитор (заполняет сам врач); подпись расшифровавшего врача."], "note": "", "id": "e49"}, {"title": "Отчёт: замена картриджей и фотобарабанов", "body": ["Тумбочка, второй выдвижной ящик.", "Указываем: дату; кабинет/помещение; что заменяли (картридж или фотобарабан)."], "note": "", "id": "e50"}, {"title": "Отчёт: «Бесплатные приёмы»", "body": ["Папка вместе с кассовым отчётом. Заполняется, когда пациент не будет оплачивать услуги (документы подписываем всё равно; информация сообщается заранее и прописывается в комментариях к приёму).", "Указываем: дату; ФИО пациента; ФИО доктора; услугу и её стоимость; с кем из администрации согласована запись."], "note": "", "id": "e51"}]}, {"id": "conflict", "title": "Конфликты и безопасность", "icon": "shield", "color": "#C00000", "entries": [{"title": "Претензии и жалобы пациента", "body": ["Оставаться в спокойствии, попытаться успокоить пациента.", "Если урегулировать конфликт самостоятельно не удаётся — предложить пациенту написать жалобу в свободной форме (администраторы передадут её администрации клиники), либо отправить жалобу на электронную почту. Администрация обязательно рассмотрит обращение в течение 30 дней и ответит пациенту."], "note": "", "id": "e52"}, {"title": "Если конфликт набирает обороты", "body": ["Если решение администрации не устраивает пациента и конфликт продолжает нарастать — сообщить администрации клиники и далее придерживаться её инструкций."], "note": "", "id": "e53"}, {"title": "Угроза безопасности сотрудников", "body": ["Если пациент настроен агрессивно и может угрожать безопасности сотрудников — на ресепшене, у кассы, с левой стороны расположена тревожная кнопка. Используется в критических ситуациях для вызова бригады охраны (Росгвардия)."], "note": "Код для отмены вызова охраны: 1224259 (см. также «Техника и контакты»)", "id": "e54"}]}, {"id": "doctors", "title": "Врачи клиники", "icon": "stetho", "color": "#548235", "entries": [{"title": "Клюквина Наталия Геннадьевна — ревматолог (д.м.н, стаж 34 года)", "body": ["Системная красная волчанка и варианты (с дебютом в подростковом и пожилом возрасте, СКВ у мужчин, лекарственная волчанка), ведение больных СКВ в период беременности, антифосфолипидный синдром, системные заболевания соединительной ткани (системная склеродермия, идиопатические воспалительные миопатии, синдром Рейно), системные васкулиты, воспалительные заболевания суставов и позвоночника (ревматоидный артрит, псориатический артрит, анкилозирующий спондилоартрит, серонегативные спондилиты), метаболические артриты (подагра, хондрокальциноз), остеоартрит."], "note": "", "id": "e55"}, {"title": "Статейнова Ольга Вадимовна — ревматолог (стаж 15 лет)", "body": ["Диагностика и лечение иммуновоспалительных ревматических заболеваний: ревматоидный артрит, ревматическая полимиалгия, спондилоартропатии (анкилозирующий спондилит, реактивный артрит, псориатический артрит), микрокристаллические артриты (подагра, пирофосфатная артропатия), системные заболевания соединительной ткани (СКВ, болезнь Шегрена, системная склеродермия, дерматополимиозит)."], "note": "", "id": "e56"}, {"title": "Новикова Диана Сергеевна — кардиолог (д.м.н, стаж 26 лет)", "body": ["Врождённые и приобретённые пороки сердца, ишемическая болезнь сердца, сердечная недостаточность, стенокардия, воспалительные заболевания миокарда, нарушения ритма сердца, гипертония."], "note": "", "id": "e57"}, {"title": "Удачкина Елена Васильевна — кардиолог (к.м.н, стаж 17 лет)", "body": ["Ревмокардиология, артериальная гипертензия, ишемическая болезнь сердца, сердечная недостаточность, нарушения ритма сердца."], "note": "", "id": "e58"}, {"title": "Таджиева Нигина Исламовна — кардиолог (к.м.н, стаж 27 лет)", "body": ["Профилактика сердечно-сосудистых заболеваний, лечение артериальной гипертонии, нарушений ритма сердца, хронической сердечной недостаточности, ишемической болезни сердца, врождённых и приобретённых пороков сердца, воспалительных заболеваний миокарда."], "note": "Единственный врач, расшифровывающий респираторный скрининг", "id": "e59"}, {"title": "Никитина Тина Ягоровна — кардиолог (к.м.н, стаж 24 года)", "body": ["Врождённые и приобретённые пороки сердца, ишемическая болезнь сердца, сердечная недостаточность, стенокардия, воспалительные заболевания миокарда, нарушения ритма сердца, гипертония."], "note": "", "id": "e60"}, {"title": "Каландия Мария Малхазовна — эндокринолог, диетолог (к.м.н, стаж 8 лет)", "body": ["Нарушения углеводного обмена (сахарный диабет 1 и 2 типов, гестационный диабет, обучение пациентов по структурированной программе); ожирение, метаболический синдром; патология щитовидной железы (аутоиммунный тиреоидит, диффузный токсический зоб, узловые и многоузловые зобы, злокачественные образования щитовидной железы); нейроэндокринные заболевания, патология околощитовидных желез, остеопороз, заболевания надпочечников (синдром Иценко-Кушинга, первичный гиперальдостеронизм, феохромоцитома)."], "note": "", "id": "e61"}, {"title": "Щелокова Ольга Андреевна — психиатр (высшая категория, стаж 25 лет)", "body": ["Тревожные расстройства, депрессия, биполярное расстройство, психосоматические расстройства, расстройства шизофренического спектра."], "note": "НЕ специализируется на лечении деменции и зависимостей", "id": "e62"}, {"title": "Корсакова Юлия Олеговна — функциональная диагностика (стаж 26 лет)", "body": ["Эхокардиография (+плевральная полость); эхокардиография с оценкой деформации миокарда в двумерном режиме (STRAIN); дуплексное сканирование экстракраниального отдела брахиоцефальных артерий; УЗ-допплерография артерий нижних конечностей; УЗ дуплексное сканирование почечных артерий."], "note": "", "id": "e63"}, {"title": "Маховская Ольга Владимировна — функциональная диагностика (стаж 17 лет)", "body": ["Эхокардиография; эхокардиография с оценкой деформации миокарда в двумерном режиме (STRAIN); дуплексное сканирование экстракраниального отдела брахиоцефальных артерий; УЗ-допплерография артерий нижних и верхних конечностей; УЗ-допплерография вен нижних и верхних конечностей."], "note": "", "id": "e64"}, {"title": "Волкова Наталья Борисовна — врач УЗИ (стаж 18 лет)", "body": ["Экспертное исследование суставов, мышц, сухожилий, сосудов конечностей, диагностика туннельных синдромов, выявление опухолевых образований в нервах, обследование нервов кисти и пальцев для выявления повреждений после травм, УЗИ органов брюшной полости, почек, щитовидной и слюнных желез, молочных желез и лимфоузлов."], "note": "", "id": "e65"}, {"title": "Амнинова Цаган Владимировна — гастроэнтеролог (стаж 10 лет)", "body": ["Заболевания верхних отделов ЖКТ, печени, желчевыводящих путей и поджелудочной железы, заболевания кишечника."], "note": "", "id": "e66"}, {"title": "Хряпин Дмитрий Александрович — травматолог-ортопед (стаж 14 лет)", "body": ["Ревмоортопедия, локальная инъекционная терапия при заболеваниях суставов, введение гиалуроновой кислоты в полости крупных и мелких суставов, лечение заболеваний опорно-двигательного аппарата, технологии с применением аллогенной плазмы, насыщенной тромбоцитарной массой: PRP-терапия (плазмотерапия, плазмолифтинг), параартикулярные инъекции препаратов коллагена, амбулаторное ведение пациентов после сложных оперативных вмешательств."], "note": "", "id": "e67"}]}, {"id": "labs", "title": "Анализы — памятка", "icon": "flask", "color": "#BF8F00", "entries": [{"title": "Показатели гепатита В для капельницы", "body": ["73 — HBsAg (антиген s ВГБ)", "75 — Анти-HBcore (АТ суммарные к сердцевине ВГБ)", "78 — Anti-HBs (антитела к HBs-антигену ВГБ)", "030107 — ВГБ (HBV), качественное определение ДНК (319СВ)", "74 — HBeAg (антиген e ВГБ)", "77 — АТ к антигену «е» ВГБ (анти-HBeAg)"], "note": "", "id": "e68"}, {"title": "Коэффициент насыщения трансферрина железом — что входит", "body": ["1. Сывороточное железо", "2. Ферритин", "3. Железосвязывающая способность сыворотки (ЛЖСС)", "4. Трансферрин"], "note": "", "id": "e69"}, {"title": "Общий белок", "body": ["ВХОДИТ в анализ «Белковые фракции» — при оформлении вносим только «белковые фракции»."], "note": "", "id": "e70"}, {"title": "В-клетки (CD-19)", "body": ["ВХОДИТ в анализ «Иммунограмма» — при оформлении вносим только «иммунограмму»."], "note": "", "id": "e71"}, {"title": "При оформлении анализов — обратить внимание", "body": ["• Д-димер — спрашивать цикл", "• Половые гормоны — указывать дату цикла", "• Проба Реберга — указывать рост + вес + суточный объём мочи", "• Волчаночный антикоагулянт — уточнить: беременность?"], "note": "", "id": "e72"}, {"title": "Вопросы по анализам", "body": ["Все возникающие вопросы по анализам администраторы адресуют работникам лаборатории: через чат в Битриксе «вопросы по лаборатории» или лично сотруднику лаборатории в клинике (1-й кабинет)."], "note": "", "id": "e73"}]}, {"id": "prep", "title": "Подготовка к исследованиям", "icon": "flask", "color": "#0F6E5C", "entries": [{"title": "С13 — дыхательный уреазный тест (диагностика Helicobacter pylori)", "body": ["Для проведения теста пациенту необходимо принести с собой 200 мл апельсинового сока. В случае аллергии/непереносимости его можно заменить на яблочный.", "", "Исследование проводится:", "• натощак либо через 6 часов после лёгкого перекуса", "• через 4 недели после окончания приёма антибиотиков и препаратов висмута", "• через 2 недели после окончания приёма ингибиторов протонной помпы (омепразол, рабепразол, эзомепразол и т.д.)", "• за 2 дня до исследования исключить приём антацидов и блокаторов Н2-гистаминовых рецепторов (фамотидин, ранитидин и др.)", "• тест нельзя проводить в один день с гастроскопией", "• исключить физические перегрузки за 24 часа до исследования", "• за час до исследования не курить"], "note": "Пациент должен принести сок с собой", "id": "e74"}, {"title": "УЗИ органов брюшной полости", "body": ["За 2–3 дня до исследования принимать Эспумизан по 2 капсулы 3 раза в сутки (снижает избыточное газообразование).", "", "День исследования — строго натощак. Голод 8–12 часов:", "• если процедура утром — не завтракать", "• если во второй половине дня — допускается лёгкий завтрак, но до исследования должно пройти не менее 6–8 часов голода", "", "Ограничение воды: желательно не пить за пару часов до теста — глотание воздуха и жидкость в желудке могут помешать осмотру.", "", "Запреты: перед процедурой нельзя курить и жевать жвачку — это вызывает рефлекторное сокращение желчного пузыря и выделение желудочного сока, что исказит результаты."], "note": "", "id": "e75"}, {"title": "УЗИ желчного пузыря с нагрузкой", "body": ["Подготовка такая же, как при УЗИ органов брюшной полости (Эспумизан за 2–3 дня, строго натощак, без курения и жвачки перед процедурой).", "", "Дополнительно: пациенту обязательно принести с собой 200 мл сливок 20% жирности — это и есть «нагрузка» для оценки сократимости желчного пузыря."], "note": "Сливки пациент приносит с собой и НЕ пьёт их заранее — только по указанию врача во время исследования", "id": "e76"}]}, {"id": "tech", "title": "Техника и контакты", "icon": "wrench", "color": "#833C00", "entries": [{"title": "Перезагрузка терминала", "body": ["Нажать одновременно зелёную клавишу и цифру «7». Ввести пароль 1 alpha alpha 66831 (кнопка «alpha» — серая, между фиолетовыми). В появившемся окне выбрать «Restart»."], "note": "", "id": "e77"}, {"title": "ККТ (кассовый аппарат) — управление", "body": ["• Включение — одно нажатие на кнопку", "• Промотка кассовой (чековой) ленты — нажать и удерживать", "• Выключение — быстро трижды нажать"], "note": "", "id": "e78"}, {"title": "Чек не печатается / касса не реагирует", "body": ["1. Перезагрузить компьютер + выключить и включить кассу.", "2. Если не помогло — вытащить провод контакта компьютера с кассой, переключить в другой разъём, повторить перезагрузку и выключение/включение кассы.", "3. Если не помогло — обратиться в техподдержку MEDODS."], "note": "", "id": "e79"}, {"title": "Техподдержка MEDODS", "body": ["+7-3519-59-00-61", "+7-922-759-00-61"], "note": "В телеграме закреплён диалог для любых проблем с программой MEDODS", "id": "e80"}, {"title": "Техподдержка PROMOBOT", "body": ["8-800-551-65-48, доб. 302"], "note": "Также закреплён диалог в телеграме — по проблемам со сканером PROMOBOT", "id": "e81"}, {"title": "Охрана «Рустелематика» (тревожная кнопка)", "body": ["Тел. организации: +7 (495) 909-92-01", "Сайт: rustelematika.ru", "Центр реагирования: +7 (495) 909-92-30"], "note": "Код для отмены вызова охраны: 1224259", "id": "e82"}, {"title": "Пароль от ноутбуков", "body": ["111222333"], "note": "", "sensitive": true, "id": "e83"}, {"title": "Пароль от ноутбука во 2 кабинете", "body": ["123456"], "note": "", "sensitive": true, "id": "e84"}, {"title": "Пароль от компьютера в 8 кабинете", "body": ["dianahh75"], "note": "", "sensitive": true, "id": "e85"}, {"title": "Пароль от Wi-Fi revmo_5G", "body": ["ruben2417"], "note": "", "sensitive": true, "id": "e86"}, {"title": "Мобильные телефоны клиники", "body": ["«Синий» телефон — +7-929-661-87-88 (Telegram, WhatsApp)", "«Красный» телефон — +7-929-661-88-18"], "note": "", "id": "e87"}]}];

const chipsEl = document.getElementById('chips');
const resultsEl = document.getElementById('results');
const statusEl = document.getElementById('status');
const emptyEl = document.getElementById('empty');
const searchEl = document.getElementById('search');
const clearBtn = document.getElementById('clear-btn');

let activeCat = 'all';
let query = '';

function escapeHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function highlight(text, q) {
  const esc = escapeHtml(text);
  if (!q) return esc;
  try {
    const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
    return esc.replace(re, '<mark>$1</mark>');
  } catch(e) { return esc; }
}

function matches(entry, q) {
  if (!q) return true;
  const attText = (entry.attachments||[]).map(a=>a.label).join(' ');
  const hay = (entry.title + ' ' + entry.body.join(' ') + ' ' + (entry.note||'') + ' ' + attText).toLocaleLowerCase('ru');
  return hay.includes(q);
}

function buildChips() {
  let html = `<div class="chip ${activeCat==='all'?'active':''}" data-cat="all">Все разделы</div>`;
  DATA.forEach(cat => {
    html += `<div class="chip ${activeCat===cat.id?'active':''}" data-cat="${cat.id}">
      <svg class="ic"><use href="#i-${cat.icon}"></use></svg>${cat.title}
    </div>`;
  });
  chipsEl.innerHTML = html;
  chipsEl.querySelectorAll('.chip').forEach(ch => {
    ch.addEventListener('click', () => {
      activeCat = ch.dataset.cat;
      render();
    });
  });
}

function render() {
  const q = query.trim().toLocaleLowerCase('ru');
  let totalMatches = 0;
  let visibleCats = 0;
  let out = '';

  DATA.forEach(cat => {
    if (activeCat !== 'all' && activeCat !== cat.id) return;
    const entries = cat.entries.filter(e => matches(e, q));
    if (entries.length === 0) return;
    visibleCats++;
    totalMatches += entries.length;

    out += `<section class="category">
      <div class="category-head">
        <div class="cat-icon" style="background:${cat.color}">
          <svg><use href="#i-${cat.icon}"></use></svg>
        </div>
        <h2>${cat.title}</h2>
        <span class="count">${entries.length}</span>
      </div>
      <div class="card-list">`;

    entries.forEach(e => {
      const open = q.length > 0;
      const bodyLines = e.body.map(l => `<div class="line">${highlight(l, q)}</div>`).join('');
      const noteHtml = e.note ? `<div class="note ${e.sensitive?'sensitive':''}">${highlight(e.note, q)}</div>` : '';
      const attHtml = (e.attachments && e.attachments.length) ? `<div class="attachments">${
        e.attachments.map(a => `<a class="attachment-link" href="${a.file}" target="_blank" rel="noopener">
          <svg class="ic"><use href="#i-paperclip"></use></svg>${escapeHtml(a.label)}
        </a>`).join('')
      }</div>` : '';
      out += `<div class="entry ${open?'open':''}" data-id="${e.id}">
        <button class="entry-btn" type="button">
          <span>${highlight(e.title, q)}</span>
          <svg class="chev"><use href="#i-chevron"></use></svg>
        </button>
        <div class="entry-body"><div class="entry-body-inner">${bodyLines}${noteHtml}${attHtml}</div></div>
      </div>`;
    });

    out += `</div></section>`;
  });

  resultsEl.innerHTML = out;
  emptyEl.style.display = (visibleCats === 0) ? 'block' : 'none';

  if (q) {
    statusEl.innerHTML = `Найдено <b>${totalMatches}</b> ${declOfNum(totalMatches)} в <b>${visibleCats}</b> ${declOfCat(visibleCats)}`;
  } else {
    const total = DATA.reduce((s,c)=>s + (activeCat==='all' || activeCat===c.id ? c.entries.length : 0), 0);
    statusEl.innerHTML = `Всего <b>${total}</b> ${declOfNum(total)}${activeCat==='all' ? ' в базе знаний' : ''}`;
  }

  resultsEl.querySelectorAll('.entry-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.entry').classList.toggle('open');
    });
  });
}

function declOfNum(n) {
  const n10 = n % 10, n100 = n % 100;
  if (n10 === 1 && n100 !== 11) return 'запись';
  if ([2,3,4].includes(n10) && ![12,13,14].includes(n100)) return 'записи';
  return 'записей';
}
function declOfCat(n) {
  const n10 = n % 10, n100 = n % 100;
  if (n10 === 1 && n100 !== 11) return 'разделе';
  return 'разделах';
}

searchEl.addEventListener('input', () => {
  query = searchEl.value;
  clearBtn.classList.toggle('show', query.length > 0);
  render();
});
clearBtn.addEventListener('click', () => {
  searchEl.value = '';
  query = '';
  clearBtn.classList.remove('show');
  searchEl.focus();
  render();
});
document.addEventListener('keydown', (e) => {
  if (e.key === '/' && document.activeElement !== searchEl) {
    e.preventDefault();
    searchEl.focus();
  }
  if (e.key === 'Escape' && document.activeElement === searchEl) {
    searchEl.value=''; query=''; clearBtn.classList.remove('show'); render();
  }
});

buildChips();
render();
searchEl.focus();
</script>
</body>
</html>
